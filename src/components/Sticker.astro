---
// The starburst from the pitch deck.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class:list={['sticker', className]} viewBox="0 0 100 100" aria-hidden="true">
  <polygon
    points="50.0,1.0 58.2,8.8 68.8,4.7 73.3,15.1 84.6,15.4 84.9,26.7 95.3,31.2 91.2,41.8 99.0,50.0 91.2,58.2 95.3,68.8 84.9,73.3 84.6,84.6 73.3,84.9 68.8,95.3 58.2,91.2 50.0,99.0 41.8,91.2 31.2,95.3 26.7,84.9 15.4,84.6 15.1,73.3 4.7,68.8 8.8,58.2 1.0,50.0 8.8,41.8 4.7,31.2 15.1,26.7 15.4,15.4 26.7,15.1 31.2,4.7 41.8,8.8"
    stroke-width="3"
    stroke-linejoin="round"></polygon>
  <rect x="45" y="22" width="10" height="56" rx="5"></rect>
  <rect x="45" y="22" width="10" height="56" rx="5" transform="rotate(60 50 50)"></rect>
  <rect x="45" y="22" width="10" height="56" rx="5" transform="rotate(120 50 50)"></rect>
</svg>
