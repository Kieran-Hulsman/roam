# ID of the Google Sheet with the form responses (the long part of its URL). Kept out of the repo
# because the sheet includes respondents' emails.
GOOGLE_SHEET_ID=

# Google Places API (New) key — only used by `npm run data:process`, never shipped to the site.
GOOGLE_PLACES_API_KEY=

# CARTO basemap key (https://carto.com/basemaps/apikey). Ends up in the browser — restrict it by domain.
PUBLIC_CARTO_KEY=
